# 虚拟环境
venv/
.venv/

# Python 缓存
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# 环境变量（含密钥，禁止入库）
.env
*.local

# ML 产物
backend/ml/artifacts/
backend/ml/data/
*.pkl
*.joblib

# 上传文件与检测产物（D5，不入库）
backend/uploads/

# 编辑器/系统
.vscode/
.idea/
.DS_Store
Thumbs.db

# 本地草稿（非交付物）
tishi.md

# settings 缓存内容不入库（目录结构与 pip.ini 保留）
settings/pip-cache/*
settings/matplotlib/*
settings/logs/*
settings/npm-cache/*
!settings/pip-cache/.gitkeep
!settings/matplotlib/.gitkeep
!settings/logs/.gitkeep
!settings/npm-cache/.gitkeep

# 设计文档/评审等非项目文档（不提交到远程仓库）
Graduation project/
