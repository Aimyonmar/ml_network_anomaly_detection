# 应用
APP_NAME=ml_network_anomaly_detection
DEBUG=true

# 数据库
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=anomaly_detection

# 安全
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ML
MODEL_PATH=ml/artifacts/model.pkl
FEATURES_PATH=ml/features.json

# ML V2（product 分支）：v1=NSL-KDD 模型（默认）；v2=CIC-IDS2017
MODEL_VERSION=v1
MODEL_PATH_V2=ml/artifacts/model_v2.pkl
FEATURES_PATH_V2=ml/features_cicids.json
# v2 判定阈值：python -m ml.threshold_optimizer 跑出推荐值后回填（v1 恒 0.5 不受此键影响）
MODEL_DECISION_THRESHOLD=0.5

# V2 告警与处置建议
ALERT_CONFIDENCE_THRESHOLD=0.90
# webhook 留空=不外发；feishu 群机器人示例 https://open.feishu.cn/open-apis/bot/v2/hook/xxxx
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TYPE=generic
